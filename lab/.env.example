# Copy to .env.local and fill in. Never commit .env.local.

# --- model -------------------------------------------------------------------
# Required for generation, claim extraction and the entailment judge.
# Without it the lab still runs: keyword retrieval plus the deterministic date, figure
# and citation checks all work offline, and claims fall back to sentence splitting.
GEMINI_API_KEY=
MODEL_ID=gemini-3.1-flash-lite
EMBED_MODEL_ID=gemini-embedding-001
EMBED_DIMS=768

# --- audit log (Supabase) ----------------------------------------------------
# Server-side only. The browser never receives these; it talks to FastAPI, which holds them.
# No RLS is used — access is via the secret key from the server, matching the CANVAS posture.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# --- certificate signing -----------------------------------------------------
# base64url raw 32-byte Ed25519 seed. Generate with: python scripts/gen_keys.py
# If unset the app signs with an ephemeral key and reports ephemeral: true, so a throwaway
# identity is never mistaken for a configured one.
SIGNING_SEED=

# --- behaviour ---------------------------------------------------------------
# Pin the temporal validator's "now". Leave blank to use the real date.
# Setting this makes the future-event demo reproducible on any future day.
REFERENCE_CLOCK=
MAX_CLAIMS=12
REQUEST_TIMEOUT=45
